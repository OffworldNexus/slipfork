[Unit]
Description=Slipfork daemon (unprivileged HTTP/WS ingress, world registry, and daemon control)

[Service]
Type=simple
User=slipforktest
ExecStart=/usr/local/bin/slipforkd --state-dir /home/slipforktest/.local/share/slipfork --runtime-dir /run/user/1000/slipfork
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/slipforktest/.local/share/slipfork /run/user/1000/slipfork
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536
