# The `0.1.0` hands-on demo. `tools/do_vm.py sync` seeds this directory at
# `/home/slipfork/demo`: an API service, a static front, and one PostgreSQL 18
# database, all behind `http://demo.localhost`.

project demo

postgres pg {
    database demo
}

env app {
    DATABASE_URL = demo.url
    DEMO_SECRET  = secret(DEMO_SECRET) ?? random_hex(16)
    DEBUG        = "1"
}

service api ./api {
    use env app
    port 8000
    route /api
    volume .venv
    setup: python3 -m venv --system-site-packages .venv
    pre-deploy: .venv/bin/python migrate.py
    run .venv/bin/python server.py $port
}

service front ./front {
    port 5173
    route /
    run python3 serve.py $port
}

task migrate in api: .venv/bin/python migrate.py
