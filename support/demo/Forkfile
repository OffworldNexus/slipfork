# forkfile: 0.1
features {
  default = [dev]
  dev = [mail]
  mail
}

domain main

postgres pg {
  database app_db
}

redis cache

s3 uploads

s3 assets {
  policy public-read
}

env common {
  DATABASE_URL = app_db.url
  REDIS_URL = cache.url
  S3_ENDPOINT = uploads.endpoint
  S3_ACCESS_KEY = uploads.access_key
  S3_SECRET_KEY = uploads.secret_key
  UPLOADS_URL = uploads.url
  ASSETS_BUCKET = "assets"
  UPLOADS_BUCKET = "uploads"
  PUBLIC_URL = main.url
  SECRET_KEY = secret(SECRET_KEY) ?? random_hex(32)
  on mail: SMTP_ADDR = "127.0.0.1:1025"
}

image backend . {
  use env common
  on dev: stage dev
  service api {
    port 8000
    route /api
    pre-deploy: uv run python -m app.migrate
    run: @uv run uvicorn app.main:app --host 0.0.0.0 --port $port
    on dev: run: @uv run uvicorn app.main:app --reload --host 0.0.0.0 --port $port
  }
  service worker {
    run: @uv run python -m app.worker
  }
}

image frontend ./front {
  use env common
  on dev: stage dev
  service front {
    port 4173
    route /
    run: @pnpm exec node build
    on !dev: pre-deploy: pnpm run build
    on dev {
      port 5173
      run: @pnpm exec vite dev --host 0.0.0.0 --port $port
    }
  }
}

on mail {
  domain mail
  image mailpit from axllent/mailpit:latest {
    service mailpit {
      port 8025
      route / domain mail
    }
  }
}
