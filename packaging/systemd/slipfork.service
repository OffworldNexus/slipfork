# The per-user daemon unit. The package ships it and its install hook enables
# and starts it for the installing user, so `slipfork up` usually needs nothing.
# A tarball or headless install copies it to $XDG_CONFIG_HOME/systemd/user and
# runs `systemctl --user enable --now slipfork`.
[Unit]
Description=Slipfork per-user daemon

[Service]
Type=simple
ExecStart=/usr/bin/slipfork __daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
