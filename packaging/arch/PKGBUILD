# Maintainer: Offworld Nexus <hello@offworld.nexus>
# AUR `slipfork-bin`: installs the released Arch package; it never rebuilds from
# source and never references a `payload/` staging tree. Release automation
# substitutes the sha256 of each architecture's published `.pkg.tar.zst`.
pkgname=slipfork-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Copy-on-write Btrfs development environments, Docker-free"
arch=('x86_64' 'aarch64')
url="https://github.com/OffworldNexus/slipfork"
license=('custom')
depends=('glibc' 'crun' 'btrfs-progs' 'slirp4netns')
provides=('slipfork')
conflicts=('slipfork')
# The hooks live in slipfork.install (`post_install`/`pre_remove`) so pacman
# runs them; the package enables the per-user daemon and the `:80` socket for
# the installing user.
install=('slipfork.install')
options=('!strip')
_asset="slipfork-${pkgver}-1-${CARCH}.pkg.tar.zst"
source_x86_64=("${_asset}::${url}/releases/download/v${pkgver}/${_asset}")
source_aarch64=("${_asset}::${url}/releases/download/v${pkgver}/${_asset}")
# REPLACE_WITH_RELEASE_SHA256 is filled by the AUR maintainer from the published
# release's SHA256SUMS at release time; no repository script rewrites this file.
sha256sums_x86_64=('REPLACE_WITH_RELEASE_SHA256')
sha256sums_aarch64=('REPLACE_WITH_RELEASE_SHA256')

package() {
  tar -xf "${srcdir}/${_asset}" -C "${pkgdir}"
}
